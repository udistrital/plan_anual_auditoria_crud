{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "diagnostics": {
          "ignoreCodes": [151002]
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "setupFiles": ["<rootDir>/../src/config/test-setup.ts"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
