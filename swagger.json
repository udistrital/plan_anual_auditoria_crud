    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "PlanAuditoriaDTO": {
        "type": "object",
        "properties": {
          "objetivo": {
            "type": "string"
          },
          "alcance": {
            "type": "string"
          },
          "criterio": {
            "type": "string"
          },
          "recurso": {
            "type": "string"
          },
          "creadoPorId": {
            "type": "number"
          },
          "estadoId": {
            "type": "number"
          },
          "vigenciaId": {
            "type": "number"
          },
          "aprobadoJefeDependencia": {
            "type": "boolean"
          },
          "jefeDependenciaId": {
            "type": "number"
          },
          "aprobadoSecretarioTecnico": {
            "type": "boolean"
          },
          "secretarioTecnicoId": {
            "type": "number"
          },
          "activo": {
            "type": "boolean"
          },
          "fechaCreacion": {
            "format": "date-time",
            "type": "string"
          },
          "fechaModificacion": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "objetivo",
          "alcance",
          "criterio",
          "recurso",
          "creadoPorId",
          "estadoId",
          "vigenciaId",
          "aprobadoJefeDependencia",
          "jefeDependenciaId",
